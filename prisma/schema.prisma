generator client {
  provider = "prisma-client"
  output   = "../generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum AssetClass {
  FUTURES
  OPTIONS
  EQUITY
}

enum Direction {
  LONG
  SHORT
}

enum TradeStatus {
  OPEN
  CLOSED
  MISSED
  SKIP
}

enum RuleBreakType {
  EARLY_EXIT
  LATE_EXIT
  MOVED_STOP
  OVERSIZED
  REVENGE_TRADE
  OTHER
}

enum TriggerDirection {
  LONG
  SHORT
  BOTH
}

enum StrategyType {
  STANDARD
  ORB
}

enum OrbDirection {
  ORIGINAL
  ANTI
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Setup {
  id               String        @id @default(cuid())
  name             String        @unique
  description      String?
  pdfUrl           String?
  pdfCloudinaryId  String?
  strategyType     StrategyType  @default(STANDARD)
  trades           Trade[]
  subSetups        SubSetup[]
  triggerRules     TriggerRule[]
  createdAt        DateTime      @default(now())
}

model SubSetup {
  id          String   @id @default(cuid())
  setupId     String
  setup       Setup    @relation(fields: [setupId], references: [id])
  name        String
  description String?
  trades      Trade[]
  createdAt   DateTime @default(now())

  @@unique([setupId, name])
  @@index([setupId])
}

model Trade {
  id              String  @id @default(cuid())
  clientRequestId String? @unique
  instrument String
  // Optional FK to a configured Instrument carrying the per-instrument PnL factor.
  // The plain `instrument` string above is kept for backfill matching (string → symbol)
  // and as the fallback when no Instrument is linked (factor=1/MULTIPLY).
  instrumentId  String?
  instrumentRef Instrument? @relation(fields: [instrumentId], references: [id])
  assetClass AssetClass
  expiry     DateTime?
  setupId    String
  setup      Setup       @relation(fields: [setupId], references: [id])
  subSetupId String?
  subSetup   SubSetup?   @relation(fields: [subSetupId], references: [id])
  direction  Direction
  entryPrice Decimal     @db.Decimal(18, 6)
  stopLoss   Decimal     @db.Decimal(18, 6)
  targets    Decimal[]
  exitPrice  Decimal?    @db.Decimal(18, 6)
  quantity   Decimal     @db.Decimal(18, 4)
  riskAmount Decimal     @db.Decimal(18, 2)
  rMultiple  Decimal?    @db.Decimal(8, 2)
  pnl        Decimal?    @db.Decimal(18, 2)
  status        TradeStatus @default(OPEN)
  thesis        String?
  notes         String?
  tradeDate     DateTime    @default(now())
  idealExit     Decimal?    @db.Decimal(18, 6)
  sideCorrect      Boolean?
  executionPnl     Decimal?  @db.Decimal(18, 2)
  entryRuleCorrect Boolean?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  images        ChartImage[]
  ruleBreak     RuleBreak?
  triggerRules  TradeTrigger[]

  @@index([tradeDate])
  @@index([setupId])
  @@index([status])
  @@index([assetClass])
  @@index([instrumentId])
}

model Instrument {
  id        String   @id @default(cuid())
  symbol    String   @unique
  name      String
  // Per-instrument constant applied to currency PnL (pnl, executionPnl, pnlImpact).
  // factorOp decides whether it multiplies or divides. Defaults are a no-op so any
  // trade not linked to an Instrument behaves exactly as before.
  factor    Float    @default(1)
  factorOp  String   @default("MULTIPLY") // "MULTIPLY" | "DIVIDE"
  trades    Trade[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChartImage {
  id           String   @id @default(cuid())
  tradeId      String
  trade        Trade    @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  cloudinaryId String
  url          String
  label        String?
  uploadedAt   DateTime @default(now())
}

model RuleBreak {
  id               String        @id @default(cuid())
  tradeId          String        @unique
  trade            Trade         @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  breakType        RuleBreakType
  ruleDescription  String
  actualExitPrice  Decimal       @db.Decimal(18, 6)
  ruleExitPrice    Decimal?      @db.Decimal(18, 6)
  pnlImpact        Decimal       @db.Decimal(18, 2)
  rMultipleImpact  Decimal       @db.Decimal(8, 2)
  notes            String?
  createdAt        DateTime      @default(now())
}

model TriggerRule {
  id          String           @id @default(cuid())
  setupId     String
  setup       Setup            @relation(fields: [setupId], references: [id], onDelete: Cascade)
  precedence  Int
  name        String
  description String?
  direction    TriggerDirection @default(BOTH)
  orbDirection OrbDirection?
  isActive     Boolean          @default(true)
  trades       TradeTrigger[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([setupId, precedence])
  @@index([setupId])
}

model TradeTrigger {
  tradeId       String
  triggerRuleId String
  isPrimary     Boolean     @default(false)
  trade         Trade       @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  triggerRule   TriggerRule @relation(fields: [triggerRuleId], references: [id], onDelete: Cascade)

  @@id([tradeId, triggerRuleId])
}
