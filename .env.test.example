# Test-branch database (Neon → your project → Branches → create a "test" branch)
# Both variables must be set to the SAME test-branch connection string.
# DATABASE_URL  — used by lib/db.ts (Prisma client)
# TEST_DATABASE_URL — verified by tests/setup.ts guard to prove you're on a test branch

DATABASE_URL=""
TEST_DATABASE_URL=""
TEST_DIRECT_URL=""

# Copy all other vars from .env as-is (auth, email, cloudinary).
# Do NOT copy ANTHROPIC_API_KEY unless you want AI calls in tests.
AUTH_SECRET=
AUTH_URL=
ALLOWED_EMAIL=
EMAIL_FROM=
RESEND_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
