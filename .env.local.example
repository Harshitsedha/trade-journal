# Database (from Neon dashboard → Connection Details)
# DATABASE_URL = pooled connection string (hostname contains -pooler)
# DIRECT_URL   = direct connection string (no -pooler) — required for Prisma Migrate
DATABASE_URL=
DIRECT_URL=

# Auth
AUTH_SECRET="generate with: openssl rand -base64 32"
AUTH_URL="https://your-domain.vercel.app"

# Email gate — only this address can sign in
ALLOWED_EMAIL="your@email.com"
EMAIL_FROM="noreply@yourdomain.com"

# Resend (https://resend.com)
RESEND_API_KEY="re_..."

# Cloudinary (https://cloudinary.com)
CLOUDINARY_CLOUD_NAME="..."
CLOUDINARY_API_KEY="..."
CLOUDINARY_API_SECRET="..."

# Anthropic — used server-side only for AI coaching summaries on /analysis
ANTHROPIC_API_KEY="sk-ant-..."
